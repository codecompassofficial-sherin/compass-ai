    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  }
}
