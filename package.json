{
  "name": "compass-ai",
  "version": "0.1.0",
  "description": "AI-powered Career Execution Platform. Stop Planning. Start Executing.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/auth.integration.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.2",
    "nodemailer": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.2.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  }
}
