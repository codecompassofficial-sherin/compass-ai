# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/compass-ai

# Logging
LOG_LEVEL=info

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-characters
REFRESH_TOKEN_TTL_DAYS=30

# CORS + frontend
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=50

# SMTP (optional in development; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@compass-ai.dev
